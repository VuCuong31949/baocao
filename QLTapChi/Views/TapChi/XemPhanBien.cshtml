@model QLTapChi.Models.XemPhanBienViewModel

<div class="container">


    <!-- Hiển thị thông báo lỗi nếu có -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
            <a href="@Url.Action("Add", "TapChi")" class="btn btn-primary">Nộp bài viết mới</a>
        </div>
    }

    <!-- Hiển thị thông báo thành công nếu có -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <h3>Thông tin bài viết</h3>
    <p><strong>Tiêu đề:</strong> @Model.BaiViet.TieuDe</p>
    <p><strong>Tác giả:</strong> @Model.BaiViet.TacGia</p>
    <p><strong>Ngày gửi:</strong> @Model.BaiViet.NgayGui.ToString("dd/MM/yyyy")</p>

    <h3>Danh sách phản biện</h3>
    @foreach (var pb in Model.DanhSachPhanCong)
    {
        var phanBien = Model.DanhSachPhanBien.FirstOrDefault(p => p.IDNguoiPhanBien == pb.IDNguoiPhanBien && p.IDTapChiBaiViet == Model.BaiViet.IDTapChiBaiViet);
        <div class="review-item mb-4">
            <table class="table">
                <thead>
                    <tr>
                        <th>Người phản biện</th>
                        <th>Vòng phản biện</th>
                        <th>Ngày phản biện</th>
                        <th>Trạng thái</th>
                        <th>File phản biện</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@pb.NguoiPhanBien</td>
                        <td>@(pb.VongPhanBien.HasValue ? pb.VongPhanBien.Value.ToString() : "Chưa xác định")</td> <!-- Sửa lỗi: Chuyển int thành string -->
                        <td>@(phanBien != null ? phanBien.NgayPhanBien.ToString("dd/MM/yyyy") : "Chưa phản biện")</td>
                        <td>
                            @switch (pb.TrangThaiPhanBien)
                            {
                                case 1:
                                    @: Đạt
                                    break;
                                case 2:
                                    @: Không đạt
                                    break;
                                case 3:
                                    @: Sửa đổi nhỏ
                                    break;
                                case 4:
                                    @: Sửa đổi lớn
                                    break;
                                default:
                                    @: Chưa phản hồi
                                    break;
                            }
                        </td>
                        <td>
                            @if (phanBien != null && !string.IsNullOrEmpty(phanBien.filePB))
                            {
                                <a href="@Url.Action("DownloadFile", "PhanBien", new { id = Model.BaiViet.IDTapChiBaiViet })">Tải file</a>
                            }
                            else
                            {
                                <span>Không có file</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Phần nhận xét hiển thị bên dưới bảng -->
            <div class="review-comment mt-3">
                
                @using (Html.BeginForm("CapNhatNhanXet", "PhanBien", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("IDTapChiBaiViet", Model.BaiViet.IDTapChiBaiViet)
                    @Html.Hidden("IDNguoiPhanBien", pb.IDNguoiPhanBien)
                    
                }
            </div>
        </div>
    }

    <!-- Hiển thị nút chỉnh sửa nếu bài viết không được chấp nhận và chưa bị từ chối vĩnh viễn -->
    @if (Model.BaiViet.TrangThaiPhanBien != 4 && Model.DanhSachPhanCong.Any(pc => pc.TrangThaiPhanBien == 2 || pc.TrangThaiPhanBien == 3 || pc.TrangThaiPhanBien == 4))
    {
        <a href="@Url.Action("ChinhSuaSauPhanBien", "TapChi", new { id = Model.BaiViet.IDTapChiBaiViet })" class="btn btn-primary">Chỉnh sửa bài viết</a>
    }
</div>
@section  scripts{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof CKEDITOR !== 'undefined') {
                CKEDITOR.replace('txtDetail', {
                    customConfig: '/Content/ckeditor/config.js',
                    extraAllowedContent: 'span',
                });
                CKEDITOR.replace('txtGhiChu', {
                    customConfig: '/Content/ckeditor/config.js',
                    extraAllowedContent: 'span',
                });
            } else {
                console.error("CKEDITOR is not defined.");
            }
        });

        function BrowseServer(field) {
            var finder = new CKFinder();
            finder.selectActionFunction = function (fileUrl) {
                document.getElementById(field).value = fileUrl;
            };
            finder.popup();
        }

    </script>
}