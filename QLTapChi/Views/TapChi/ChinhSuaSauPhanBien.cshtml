@model QLTapChi.Models.TapChiBaiViet

<div class="container">
    <h2>Chỉnh sửa bài viết</h2>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @using (Html.BeginForm("ChinhSuaSauPhanBien", "TapChi", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IDTapChiBaiViet)

        <div class="form-group">
            <label>Tiêu đề</label>
            @Html.TextBoxFor(m => m.TieuDe, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.TieuDe, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Tác giả</label>
            @Html.TextBoxFor(m => m.TacGia, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.TacGia, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Từ khóa</label>
            @Html.TextBoxFor(m => m.TuKhoa, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.TuKhoa, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Đồng tác giả</label>
            @Html.TextBoxFor(m => m.DongTacGia, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.DongTacGia, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Lĩnh vực</label>
            @Html.DropDownListFor(m => m.IDLinhVuc, new SelectList(ViewBag.LinhVucList, "IDLinhVuc", "TenLinhVuc"), "Chọn lĩnh vực", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.IDLinhVuc, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>File bài viết</label>
            <input type="file" name="File" class="form-control" />
        </div>
        <div class="form-group">
            <label>Ghi chú chỉnh sửa</label>
            <textarea name="GhiChu" class="form-control" rows="4"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Lưu chỉnh sửa</button>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}