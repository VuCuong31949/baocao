                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.TieuDe</td>
                                <td>@item.TacGia</td>
                                <td>@item.TenLinhVuc</td>
                                <td>@item.VongPhanBien</td>
                                <td>
                                    @switch (item.TrangThaiPhanBien)
                                    {
                                        case 1:
                                            <span class="status-pending"><i class="fas fa-clock me-1"></i>Đang phản biện</span>
                                            break;
                                        case 2:
                                            <span class="status-success"><i class="fas fa-check me-1"></i>Đạt, chờ xuất bản</span>
                                            break;
                                        case 3:
                                            <span class="status-editing"><i class="fas fa-edit me-1"></i>Không đạt, chờ chỉnh sửa</span>
                                            break;
                                        case 4:
                                            <span class="status-rejected"><i class="fas fa-times me-1"></i>Từ chối</span>
                                            break;
                                        case 5:
                                            <span class="status-published"><i class="fas fa-check-circle me-1"></i>Đã xuất bản</span>
                                            break;
                                        default:
                                            <span class="status-pending">Chưa xác định</span>
                                            break;
                                    }
                                </td>
                                <td>@item.KetQuaPhanBien</td>
                                <td>@(item.NgayPhanBienMoiNhat?.ToString("dd/MM/yyyy") ?? "Chưa có")</td>
                                <td>@(string.IsNullOrEmpty(item.SoTapChi) ? "Chưa gán" : item.SoTapChi)</td>
                                <td>
                                    @if (item.TrangThaiPhanBien == 2)
                                    {
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input article-checkbox" id="article_@item.IDTapChiBaiViet" value="@item.IDTapChiBaiViet">
                                            <label class="form-check-label" for="article_@item.IDTapChiBaiViet">Chọn</label>
                                        </div>
                                        <a href="javascript:void(0)" onclick="xuatBanMotBai(@item.IDTapChiBaiViet)" class="btn btn-sm btn-success mt-1">Xuất bản</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="fas fa-ban me-1"></i>Không thể xuất bản</span>
                                    }
                                </td>
                            </tr>
                        }
                        <tr class="no-data" style="display: @((Model != null && Model.Any()) ? "none" : "table-row")">
                            <td colspan="9">Không có bài viết nào.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </form>

    <!-- Modal chọn số tạp chí -->
    <div class="modal fade" id="xuatBanModal" tabindex="-1" aria-labelledby="xuatBanModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="xuatBanModalLabel"><i class="fas fa-book me-2"></i>Chọn Số Tạp Chí</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="modalIDSoTapChi" class="form-label">Số Tạp Chí</label>
                        @Html.DropDownList("IDSoTapChi", (IEnumerable<SelectListItem>)ViewBag.DanhSachSoTapChi, "Chọn số tạp chí", new { @class = "form-select", @id = "modalIDSoTapChi", required = "required" })
                    </div>
                    <div class="selected-articles mb-3" id="selectedArticlesList">
                        <strong>Bài viết đã chọn:</strong>
                        <ul id="articleList" class="list-unstyled"></ul>
                    </div>
                    <button type="button" class="btn btn-primary" id="confirmXuatBanBtn">
                        <i class="fas fa-upload me-2"></i>Xác Nhận
                    </button>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Hủy
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    const checkboxes = document.querySelectorAll(".article-checkbox");
    const xuatBanBtn = document.getElementById("xuatBanBtn");
    const selectedArticlesInput = document.getElementById("selectedArticles");
    const selectedIDSoTapChiInput = document.getElementById("selectedIDSoTapChi");
    const confirmXuatBanBtn = document.getElementById("confirmXuatBanBtn");
    const modalIDSoTapChi = document.getElementById("modalIDSoTapChi");
    const articleList = document.getElementById("articleList");

    checkboxes.forEach(checkbox => {
        checkbox.addEventListener("change", () => {
            const anyChecked = Array.from(checkboxes).some(chk => chk.checked);
            xuatBanBtn.disabled = !anyChecked;
        });
    });

    xuatBanBtn.addEventListener("click", function () {
        const selectedArticles = Array.from(checkboxes)
            .filter(chk => chk.checked)
            .map(chk => chk.value);
        selectedArticlesInput.value = selectedArticles.join(",");

        // Hiển thị danh sách bài chọn trong modal
        articleList.innerHTML = "";
        selectedArticles.forEach(id => {
            const li = document.createElement("li");
            const title = document.querySelector(`#article_${id}`).closest("tr").querySelector("td:first-child").textContent;
            li.textContent = `${title} (ID: ${id})`;
            articleList.appendChild(li);
        });

        var modal = new bootstrap.Modal(document.getElementById("xuatBanModal"));
        modal.show();
    });

    confirmXuatBanBtn.addEventListener("click", function () {
        const soTapChi = modalIDSoTapChi.value;
        if (!soTapChi || soTapChi === "Chọn số tạp chí") {
            alert("Vui lòng chọn số tạp chí!");
            return;
        }
        selectedIDSoTapChiInput.value = soTapChi;
        if (confirm("Bạn có chắc muốn xuất bản các bài viết này?")) {
            document.getElementById("xuatBanForm").submit();
        }
    });

  function xuatBanMotBai(idBaiViet) {
    selectedArticlesInput.value = idBaiViet;
    modalIDSoTapChi.value = ""; // Reset dropdown
    articleList.innerHTML = "";
    const title = document.querySelector(`#article_${idBaiViet}`).closest("tr").querySelector("td:first-child").textContent;
    const li = document.createElement("li");
    li.textContent = `${title} (ID: ${idBaiViet})`;
    articleList.appendChild(li);
    var modal = new bootstrap.Modal(document.getElementById("xuatBanModal"));
    modal.show();
}
document.addEventListener("DOMContentLoaded", function () {
    const selectedId = '@ViewBag.SelectedArticleId';
    if (selectedId && selectedId !== '') {
        xuatBanMotBai(parseInt(selectedId));
    }
});
</script>