@model List<QLTapChi.Models.DanhSachXuatBanViewModel>
@{
    ViewBag.Title = "Danh Sách chờ Xuất Bản";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}


<style>
    body {
        background-color: #f8f9fa;
        font-family: Arial, sans-serif;
    }

    .container {
        margin-top: 20px;
        padding: 20px;
    }

    h2 {
        color: #0d6efd;
        margin-bottom: 20px;
    }

    .card {
        border: none;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
    }

    .table thead {
        background-color: #0d6efd;
        color: white;
    }

    .table tbody tr:hover {
        background-color: #f1f1f1;
        cursor: default;
    }

    .status-success {
        background-color: #d4edda;
        color: #155724;
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 0.9em;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 0.9em;
    }

    .status-rejected {
        background-color: #f8d7da;
        color: #721c24;
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 0.9em;
    }

    .status-editing {
        background-color: #fff3cd;
        color: #856404;
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 0.9em;
    }

    .status-published {
        background-color: #cce5ff;
        color: #004085;
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 0.9em;
    }

    .no-data {
        text-align: center;
        color: #6c757d;
        padding: 20px;
    }

    .btn-primary {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
        }

        .btn-primary:disabled {
            background-color: #6c757d;
            border-color: #6c757d;
            cursor: not-allowed;
        }

    .modal-content {
        border-radius: 10px;
    }

    .modal-header {
        background-color: #0d6efd;
        color: white;
    }

    .form-check-input:checked + .form-check-label {
        font-weight: bold;
    }

    .selected-articles {
        margin-top: 10px;
        padding: 10px;
        background-color: #f1f1f1;
        border-radius: 5px;
    }
</style>

<div class="container">
    <h2><i class="fas fa-check-circle me-2"></i>Danh Sách Chờ Xuất Bản</h2>

    <!-- Thông báo -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form chứa bảng và nút xuất bản -->
    <form id="xuatBanForm" method="post" action="@Url.Action("XuatBanNhieuBai", "XuatBan", new { area = "Admin" })">
        @Html.AntiForgeryToken()
        <input type="hidden" name="baiVietIds" id="selectedArticles" value="" />
        <input type="hidden" name="IDSoTapChi" id="selectedIDSoTapChi" value="" />

        <!-- Nút xuất bản -->
        <div class="mb-3">
            <button type="button" class="btn btn-primary" id="xuatBanBtn" disabled>
                <i class="fas fa-upload me-2"></i>Xuất Bản
            </button>
        </div>

        <!-- Bảng danh sách -->
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover table-bordered mb-0">
                    <thead>
                        <tr>
                            <th>Tiêu Đề</th>
                            <th>Tác Giả</th>
                            <th>Lĩnh Vực</th>
                            <th>Vòng Phản Biện</th>
                            <th>Trạng Thái</th>
                            <th>Kết Quả Phản Biện</th>
                            <th>Ngày Phản Biện Mới Nhất</th>
                            <th>Số Tạp Chí</th>
                            <th>Hành Động</th>
                        </tr>
                    </thead>
