@model QLTapChi.Models.LinhVuc

@{
    ViewBag.Title = "Chỉnh Sửa Lĩnh Vực";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="p-3">
    <h2 class="p-2 text-bg-light w-75">Chỉnh Sửa Lĩnh Vực</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.IDLinhVuc)

            <div class="form-group">
                @Html.LabelFor(model => model.TenLinhVuc, "Tên Lĩnh Vực", new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.TenLinhVuc, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.TenLinhVuc, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group mt-3">
                <div class="col-md-offset-2 col-md-10">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Lưu
                    </button>
                    <a href="@Url.Action("DanhSachLinhVuc")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay Lại
                    </a>
                </div>
            </div>
        </div>
    }
</div>